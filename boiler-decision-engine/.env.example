# ==========================================================
# APPLICATION
# ==========================================================

APP_NAME=Boiler Decision Engine
ENVIRONMENT=development
DEBUG=false


# ==========================================================
# MQTT
# ==========================================================

MQTT_ENABLED=true

MQTT_HOST=localhost
MQTT_PORT=1883

MQTT_USERNAME=
MQTT_PASSWORD=

MQTT_CLIENT_ID=boiler-decision-engine

MQTT_KEEPALIVE=60

MQTT_SENSOR_TOPIC=boiler/sensors
MQTT_EQUIPMENT_TOPIC=boiler/equipment
MQTT_COMMAND_TOPIC=boiler/commands
MQTT_STATE_TOPIC=boiler/state


# ==========================================================
# SENSOR VALIDATION
# ==========================================================

SENSOR_TIMEOUT_SECONDS=10
SENSOR_STALE_SECONDS=30

MIN_VALID_TEMPERATURE_C=-40
MAX_VALID_TEMPERATURE_C=125

MQ2_MIN_VALUE=0
MQ2_MAX_VALUE=4095


# ==========================================================
# COMFORT
# ==========================================================

COMFORT_TEMPERATURE_C=21

COMFORT_MIN_TEMPERATURE_C=20

COMFORT_MAX_TEMPERATURE_C=22

HYSTERESIS_C=0.5
PREHEATING_ENABLED=true
MAX_PREHEAT_MINUTES=120
WEATHER_OFFSET_ENABLED=true
WEATHER_OFFSET_SLOPE_C_PER_C=0.05
WEATHER_OFFSET_MAX_C=2.0


# ==========================================================
# SAFETY
# ==========================================================

GAS_DETECTION_ENABLED=true

TEMPERATURE_SAFETY_ENABLED=true

SENSOR_FAILURE_SAFETY_ENABLED=true


# ==========================================================
# DECISION LOOP
# ==========================================================

DECISION_LOOP_INTERVAL_SECONDS=1.0


# ==========================================================
# RUNTIME / TIMEZONE
# ==========================================================

TIMEZONE=Asia/Tehran

# ==========================================================
# EQUIPMENT FEEDBACK
# ==========================================================

EQUIPMENT_FEEDBACK_REQUIRED=false
EQUIPMENT_FEEDBACK_TIMEOUT_SECONDS=15

# ==========================================================
# BUILDING
# ==========================================================

BUILDING_MODEL=A
DESIGN_LOAD_W=10000
BASE_LOAD_PER_M2_W=100
THERMAL_RESISTANCE_K_PER_W=0.01
THERMAL_CAPACITY_WH_PER_K=10000
TIME_STEP_HOURS=1